{
  "name": "deskapp-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:template": "node scripts/sync-template.mjs",
    "docs:dev": "npm -C packages/docs run dev",
    "docs:build": "npm -C packages/docs run build",
    "docs:preview": "npm -C packages/docs run preview",
    "publish:cli": "npm run sync:template && cd packages/create-deskapp && deno publish --allow-slow-types"
  }
}