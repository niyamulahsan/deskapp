# The app runs its local stack (SQLite, in-process queue, in-process cron) -
# fully self-contained, no remote server required. Realtime (Pulse) is a client
# that connects out to a server engine when VITE_SOCKET_URL is set.

# Frontend: true = serve the UI + open windows (default);
# false = headless at runtime (tray only, no window).
DESKAPP_UI=true

# Database: defaults to the Electron userData folder
# (<userData>/<app-kebab>.sqlite). Override only if you want a custom file/path.
# DATABASE_URL=sqlite:./data/app.sqlite

# Runtime base dir for relative DATABASE_URL / storage paths.
# APP_BASE_DIR=

# App-managed storage root (private + tmp disks); defaults to <userData>/storage.
# APP_DATA_DIR=

# Chromium binary for Playwright features (optional override).
# DESKAPP_CHROMIUM=
