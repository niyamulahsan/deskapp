# The app always runs its local stack (SQLite, local queue, local cron,
# local realtime) - fully self-contained, no remote server required.
# To bridge realtime/API to a backend engine, point the UI at it at build
# time via VITE_SOCKET_URL / VITE_API_URL (see src/ui/ - vite.config.ts).

# Frontend: true = serve the UI + open windows (default);
# false = headless at runtime (server-only + tray, no window).
DESKAPP_UI=true

DATABASE_URL=sqlite:./src/storage/deskapp.sqlite
