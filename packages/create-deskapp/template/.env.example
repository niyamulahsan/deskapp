# The app always runs its local stack (SQLite, local queue, local cron,
# local realtime) - fully self-contained, no remote server required.
# To bridge realtime/API to a backend engine, point the UI at it at build
# time via VITE_SOCKET_URL / VITE_API_URL (see src/ui/ - vite.config.ts).

# Frontend: true = serve the UI + open windows (default);
# false = headless at runtime (server-only + tray, no window).
DESKAPP_UI=true

# Database: the app defaults to src/storage/<project-name>.sqlite at the
# runtime base dir (project root in dev, next to the executable in a bundle)
# - derived from deno.json > desktop.app.name. Override only if you want a
# custom file/path. Relative paths are anchored to that same base dir.
DATABASE_URL=sqlite:./src/storage/something-else.sqlite

# Runtime base dir for relative DATABASE_URL / storage paths and the folder
# .env is loaded from. Dev: project root. Bundled: next to the executable.
# Set this to an external folder (e.g. %APPDATA%/MyApp) to keep state and
# config outside the install folder on end-user machines.
# APP_BASE_DIR=