# The app always runs its local stack (SQLite, local queue, local cron,
# local realtime) - fully self-contained, no remote server required.

# Frontend: true = serve the UI + open windows (default);
# false = headless at runtime (tray only, no window).
DESKAPP_UI=true

# Database: defaults to the Electron userData folder.
# Override only if you want a custom file/path.
DATABASE_URL=sqlite:./src/storage/deskapp.sqlite

# Runtime base dir for relative DATABASE_URL / storage paths.
# APP_BASE_DIR=

# Remote server API (optional). Read by the main process at boot and used by the
# `app.net.apiFetch` binding - point it at your server in production with no
# rebuild. Leave empty to run fully offline.
API_URL=

# UI dev server port (Vite). Change this when running nexwire and deskapp side
# by side in dev so their dev servers don't conflict.
VITE_DEV_PORT=5173

# Vite (UI bundle) vars. VITE_API_URL only enables the dev proxy for the
# renderer-axios route and acts as the pulse socket fallback; VITE_SOCKET_URL
# enables Pulse. Both are build-time.
VITE_API_URL=
VITE_SOCKET_URL=
