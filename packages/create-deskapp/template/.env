# The app always runs its local stack (SQLite, local queue, local cron,
# local realtime) - fully self-contained, no remote server required.

# Frontend: true = serve the UI + open windows (default);
# false = headless at runtime (tray only, no window).
DESKAPP_UI=true

# Database: defaults to the Electron userData folder.
# Override only if you want a custom file/path.
DATABASE_URL=sqlite:./src/storage/deskapp.sqlite

# Runtime base dir for relative DATABASE_URL / storage paths.
# APP_BASE_DIR=
